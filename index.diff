+  // --- Show Room, Testimonials and FAQ: fetch the published JSON and render ---
+  // The files are written by the admin app (every save regenerates them), so they
+  // are served fresh: fetch uses cache:'no-cache' to revalidate on each page load.
+  // The files are already filtered to visible entries and sorted by priority;
+  // the filter/sort below is a harmless second check. "priority": higher = shown first.
+  //
+  // IMPORTANT: everything in those files is typed by people in the admin, so it is
+  // treated as plain text. Elements are built with createElement/textContent, never by
+  // pasting data into an HTML string. (A caption containing a quote mark or "<" would
+  // otherwise break the page, or run as script.)
+
+  function el(tag, className, text) {
+    const n = document.createElement(tag);
+    if (className) n.className = className;
+    if (text !== undefined && text !== null) n.textContent = text;
+    return n;
+  }
+
+  // GLightbox puts data-title / data-description into the lightbox as HTML,
+  // so those two values are escaped before they go into the attributes.
+  function escapeHtml(s) {
+    return String(s ?? '')
+      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+  }
+
+  const SAFE_PHOTO_PATH = /^(?!.*\.\.)[A-Za-z0-9_\-./]+\.(?:webp|jpe?g|png|gif)$/i;
+  const SAFE_LINK = /^https?:\/\//i;
+  const byPriority = (a, b) => (b.priority ?? 0) - (a.priority ?? 0);
+
+  function loadList(url) {
+    return fetch(url, { cache: 'no-cache' })
+      .then(res => { if (!res.ok) throw new Error(url + ' returned ' + res.status); return res.json(); })
+      .then(data => { if (!Array.isArray(data)) throw new Error(url + ' is not a list'); return data; });
+  }
